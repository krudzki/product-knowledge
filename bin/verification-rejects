#!/usr/bin/env python3
"""Mine the rejected-accessory log for anomalies worth a second look.

The intake filter refuses cheap accessories to protect the AI budget, but a
refusal is a budget decision, not a verdict that the item is uninteresting. This
tool re-reads the log and surfaces the cases that still look wrong: an item far
below a price it was previously observed at, or far below its peers.

Usage:
    verification-rejects --top 20            # biggest anomalies by ratio
    verification-rejects --min-saving 100    # only meaningful money
    verification-rejects --stats             # what is being refused, in bulk
"""

from __future__ import annotations

import argparse
import collections
import json
import pathlib
import sqlite3

LOG = pathlib.Path.home() / "dane/verification-rejected-accessories.jsonl"
KNOWLEDGE = pathlib.Path.home() / "dane/product-knowledge.db"


def load(path: pathlib.Path) -> list[dict]:
    if not path.exists():
        return []
    records = []
    for line in path.read_text(encoding="utf-8").splitlines():
        try:
            records.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return records


def history(urls: set[str]) -> dict[str, tuple[float, int]]:
    """url -> (max observed price, observation count)."""
    if not KNOWLEDGE.exists() or not urls:
        return {}
    con = sqlite3.connect(f"file:{KNOWLEDGE}?mode=ro", uri=True)
    con.execute("PRAGMA busy_timeout=60000")
    result: dict[str, tuple[float, int]] = {}
    try:
        rows = con.execute("""
            SELECT l.url, MAX(o.price), COUNT(o.id)
            FROM source_listings l
            JOIN price_observations o ON o.listing_id = l.id
            GROUP BY l.url""").fetchall()
        for url, high, count in rows:
            if url in urls:
                result[url] = (float(high or 0), int(count))
    except sqlite3.Error:
        return {}
    finally:
        con.close()
    return result


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--log", default=str(LOG))
    parser.add_argument("--top", type=int, default=20)
    parser.add_argument("--min-saving", type=float, default=0.0,
                        help="only show items saving at least this many PLN")
    parser.add_argument("--min-ratio", type=float, default=1.5)
    parser.add_argument("--stats", action="store_true")
    args = parser.parse_args()

    records = load(pathlib.Path(args.log))
    print(f"odrzuconych w logu: {len(records)}")
    if not records:
        return

    if args.stats:
        print("\n== wg sklepu ==")
        for store, count in collections.Counter(
                r.get("store", "?") for r in records).most_common(10):
            print(f"   {store:<26} {count:>6}")
        print("\n== wg kategorii ==")
        for slug, count in collections.Counter(
                r.get("category_slug", "?") for r in records).most_common(10):
            print(f"   {slug:<26} {count:>6}")
        print("\n== wg ceny ==")
        for lo, hi in ((0, 20), (20, 50), (50, 100), (100, 150)):
            n = sum(1 for r in records
                    if lo <= float(r.get("current_price") or 0) < hi)
            print(f"   {lo:>4}-{hi:<4} zl {n:>6}")
        return

    hist = history({r.get("url", "") for r in records})
    print(f"z historia cen: {len(hist)}\n")

    scored = []
    for record in records:
        price = float(record.get("current_price") or 0)
        high, count = hist.get(record.get("url", ""), (0.0, 0))
        if price <= 0 or count < 2 or high <= 0:
            continue
        ratio = high / price
        saving = high - price
        if ratio >= args.min_ratio and saving >= args.min_saving:
            scored.append((ratio, saving, price, high, count, record))

    scored.sort(reverse=True)
    print(f"anomalii (ratio >= {args.min_ratio}, oszczednosc >= "
          f"{args.min_saving:.0f} zl): {len(scored)}\n")
    for ratio, saving, price, high, count, record in scored[:args.top]:
        print(f"   {price:>7.0f} zl  max={high:>7.0f}  {ratio:>5.1f}x  "
              f"zysk={saving:>7.0f} zl  n={count}")
        print(f"       {record.get('title', '')[:64]}")
        print(f"       {record.get('url', '')[:78]}")


if __name__ == "__main__":
    main()
